
#!/usr/bin/env bash

# Script name
SCRIPT_NAME=$(basename "$0")

# Counters
decompressed_count=0
failed_count=0

# Flags
recursive=0
verbose=0

# Handle hidden files and empty directory globs
shopt -s nullglob dotglob

# Display help
show_help() {
    cat << EOF
Usage: $SCRIPT_NAME [-h] [-r] [-v] file [file...]

Description:
  Automatically identifies and extracts compressed files using
  the 'file' command, regardless of their extensions.

Options:
  -h    Display this help message and exit.
  -r    Recursively traverse directories.
  -v    Display extraction details and warnings.

Supported formats:
  gzip       - gunzip
  bzip2      - bunzip2
  zip        - unzip
  compress   - uncompress
EOF
}

# Parse command-line options
while getopts ":hrv" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
            ;;
        r)
            recursive=1
            ;;
        v)
            verbose=1
            ;;
        \?)
            echo "Invalid option: -$OPTARG" >&2
            show_help
            exit 1
            ;;
        :)
            echo "Option -$OPTARG requires an argument." >&2
            exit 1
            ;;
    esac
done

# Remove processed options
shift $((OPTIND - 1))

# Check that at least one argument was provided
if [[ $# -eq 0 ]]; then
    echo "Error: No files or directories specified." >&2
    show_help
    exit 1
fi

# Print messages only in verbose mode
log_verbose() {
    if [[ $verbose -eq 1 ]]; then
        echo "$1"
    fi
}

# Handle a successful extraction
extraction_success() {
    decompressed_count=$((decompressed_count + 1))
    log_verbose "Decompressed: $1"
}

# Handle a failed extraction
extraction_failure() {
    failed_count=$((failed_count + 1))
    log_verbose "WARNING: $1" >&2
}

# Extract a single archive
extract_archive() {

    local target="$1"
    local ftype

    # Identify file type
    if ! ftype=$(file -b -- "$target"); then
        extraction_failure "Cannot identify file: $target"
        return
    fi

    # Identify format and execute the appropriate command
    
case "$ftype" in

    *gzip*)
        if gunzip -c -- "$target" > "${target}.out"; then
            rm -- "$target"
            extraction_success "$target"
        else
            rm -f -- "${target}.out"
            extraction_failure "Failed to decompress: $target"
        fi
        ;;

    *bzip2*)
        if bunzip2 -c -- "$target" > "${target}.out"; then
            rm -- "$target"
            extraction_success "$target"
        else
            rm -f -- "${target}.out"
            extraction_failure "Failed to decompress: $target"
        fi
        ;;

    *Zip*archive*)
        if unzip -o -- "$target" -d "$(dirname "$target")" >/dev/null; then
            extraction_success "$target"
        else
            extraction_failure "Failed to decompress: $target"
        fi
        ;;

    *compress\'d* | *compress\ data* | *Unix\ Compress*)
        if uncompress -c -- "$target" > "${target}.out"; then
            rm -- "$target"
            extraction_success "$target"
        else
            rm -f -- "${target}.out"
            extraction_failure "Failed to decompress: $target"
        fi
        ;;

    *)
        if [[ "$ftype" == *"compressed data"* ||
              "$ftype" == *"archive data"* ]]; then
            extraction_failure "Unsupported compression format: $target"
        fi
        ;;
esac
}

# Process a directory
process_directory() {

    local directory="$1"
    local entry
    local -a files=()

    # Collect files before extraction
    if [[ $recursive -eq 1 ]]; then
        mapfile -d '' files < <(find "$directory" -type f -print0)
    else
        for entry in "$directory"/*; do
            if [[ -f "$entry" ]]; then
                files+=("$entry")
            fi
        done
    fi

    # Process collected files
    for entry in "${files[@]}"; do
        extract_archive "$entry"
    done
}

# Process an individual file or directory
process_target() {

    local target="$1"

    if [[ -d "$target" ]]; then
        process_directory "$target"

    elif [[ -f "$target" ]]; then
        extract_archive "$target"

    else
        extraction_failure "Invalid file or directory: $target"
    fi
}

# Process all input arguments
for arg in "$@"; do
    process_target "$arg"
done

# Display extraction summary
echo
echo "========== Extraction Summary =========="
echo "Decompressed archives: $decompressed_count"
echo "Files not decompressed: $failed_count"
echo "========================================="

# Return number of files not decompressed
# Linux exit codes are limited to 0-255
exit "$((failed_count > 255 ? 255 : failed_count))"
