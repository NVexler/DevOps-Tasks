
@Library('my-shared-library') _

pipeline {

    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    triggers {
        pollSCM('H/15 * * * *')
    }

    environment {
        NEXUS_RAW_URL = 'https://my-nexus.example.com/repository/raw-releases'
        NEXUS_CREDENTIALS = 'nexus-credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            steps {
                script {

                    def envDetails = prepareEnv()

                    echo "Pipeline initialized."
                    echo "Committer: ${envDetails.committer}"
                    echo "Commit: ${envDetails.commitId}"
                    echo "Branch: ${envDetails.branch}"
                }
            }
        }

        stage('Build Artifact') {
            steps {
                echo 'Building Maven application...'

                sh 'mvn clean package'
            }
        }

        stage('Pack Artifact') {
            steps {
                script {

                    def artifact = sh(
                        script: "find target -maxdepth 1 -name '*.jar' ! -name '*-sources.jar' ! -name '*-javadoc.jar' | head -n 1",
                        returnStdout: true
                    ).trim()

                    if (!artifact) {
                        error 'No JAR artifact found!'
                    }

                    env.ARTIFACT_NAME = "my-app-${BUILD_NUMBER}.tar.gz"

                    sh """
                        tar -czf '${env.ARTIFACT_NAME}' '${artifact}'
                    """

                    archiveArtifacts(
                        artifacts: env.ARTIFACT_NAME,
                        fingerprint: true
                    )

                    echo "Created archive: ${env.ARTIFACT_NAME}"
                }
            }
        }

        stage('Upload to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${NEXUS_CREDENTIALS}",
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh '''
                        curl --fail --silent --show-error \
                            --user "$NEXUS_USER:$NEXUS_PASSWORD" \
                            --upload-file "$ARTIFACT_NAME" \
                            "$NEXUS_RAW_URL/$ARTIFACT_NAME"
                    '''
                }

                echo "Artifact uploaded successfully!"
            }
        }
    }

    post {

        success {
            echo "Pipeline succeeded!"
            echo "Committer: ${env.COMMITTED_BY}"
            echo "Commit: ${env.COMMIT_HASH}"
        }

        failure {
            echo "Pipeline failed!"
        }

        always {
            echo "Build number: ${BUILD_NUMBER}"
            echo "Build status: ${currentBuild.currentResult}"
        }
    }
}
